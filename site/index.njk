---
layout: base.njk
section: lab
home: true
---
{% set next = seminars.next %}
<header class="landing" data-animation-group data-animation-name="background animation">
  <canvas class="landing-plot" data-plot="ribbon" aria-hidden="true"></canvas>
  <div class="landing-frame">
    <h1 class="landing-title" aria-label="Metrics and Models"><span aria-hidden="true">Metrics <span class="amp">&amp;</span> Models</span></h1>
    <div class="landing-copy">
      <p class="eyebrow-code" data-typing>// health &amp; social data science</p>
      <p class="landing-lead">A lab at the University of Oxford, developing computational methods for complex problems.</p>
    </div>
    <div class="landing-foot">
      <a class="landing-next" href="{{ next.url }}"><span class="pill-tag">Next talk</span><span>{{ next.date.day }} {{ next.date.month }} · {{ next.speaker }}</span></a>
      <div class="landing-links">
        <a class="bracket-link" href="/seminars/">Join the seminar</a>
        <a class="bracket-link" href="/people/">Meet the lab</a>
        <button class="motion-toggle icon-button" aria-label="Pause background animation" title="Pause background animation"><span data-pause>{% icon "pause" %}</span><span data-play hidden>{% icon "play" %}</span></button>
      </div>
    </div>
  </div>
</header>
<section id="upcoming" class="deck-section">
  <div class="container">
    <div class="section-heading section-heading-center"><h2>Open talks <span>·</span> Next up</h2><p class="section-intro">Every other Thursday, 14:00 UK time. Online and open to everyone. Pick a card to see more.</p></div>
    <div class="card-deck">
    {% for event in seminars.upcoming | withBreaks(seminarBreaks) | batch(4) | first %}{% include "deck-card.njk" %}{% endfor %}
    </div>
    <p class="deck-all"><a class="text-link" href="/seminars/">All open seminars {% icon "arrow-right" %}</a></p>
  </div>
</section>
{% set featured = publications | batch(4) | first %}
{% if featured | length %}
<section id="publications" class="container section-space">
  <div class="section-heading section-heading-center"><h2>Recent publications</h2><p class="section-intro">The latest papers from lab members.</p></div>
  <div class="feature" data-carousel>
    <div class="feature-slides">
    {% for paper in featured %}
      <article class="feature-slide tone-{{ loop.index0 }}" id="paper-{{ loop.index0 }}"{% if not loop.first %} hidden{% endif %} aria-roledescription="slide" aria-label="{{ loop.index }} of {{ featured | length }}">
        <div class="feature-cover"><span class="feature-journal">{{ paper.journal }}</span><span class="feature-year">{{ paper.year }}</span></div>
        <div class="feature-copy">
          <p class="eyebrow-code">// {{ paper.members | join(" · ") }}</p>
          <h3><a href="{{ paper.url }}" target="_blank" rel="noopener">{{ paper.title }}</a></h3>
          <p class="feature-meta"><em>{{ paper.journal }}</em> · {{ paper.year }}</p>
          <a class="button button-white" href="{{ paper.url }}" target="_blank" rel="noopener">Read the paper {% icon "arrow-up-right" %}</a>
        </div>
      </article>
    {% endfor %}
    </div>
    <ol class="feature-tabs" role="tablist" aria-label="Recent publications">
    {% for paper in featured %}
      <li><button role="tab" aria-controls="paper-{{ loop.index0 }}" aria-selected="{{ 'true' if loop.first else 'false' }}"><span class="tab-progress"></span>{{ paper.title }}</button></li>
    {% endfor %}
    </ol>
  </div>
  <p class="deck-all"><a class="text-link" href="/projects/">Projects and publications {% icon "arrow-right" %}</a></p>
</section>
{% endif %}
<section class="join-strip">
  <div class="container join-inner">
    <p>Subscribe to the mailing list for invitations and joining links.</p>
    <a class="button button-cream" href="/about/#join">Mailing list {% icon "arrow-right" %}</a>
  </div>
</section>
