---
layout: base.njk
section: seminars
pagination:
  data: seminars.details
  size: 1
  alias: talk
permalink: "{{ talk.url }}"
---
{% from "hero.njk" import hero %}
{% call hero("page") %}
  <a class="back-link" href="{% if talk.archived %}/seminars/#previous{% else %}/seminars/{% endif %}">{% icon "arrow-left" %} {% if talk.archived %}Previous talks{% else %}All seminars{% endif %}</a>
  <p class="eyebrow-code">// {% if talk.archived %}past seminar{% else %}seminar{% endif %} · {{ talk.date.day }} {{ talk.date.month }} {{ talk.date.year }}</p>
  <h1>{{ talk.title | displayTitle }}</h1>
  <p class="hero-lead speaker-line">{% if talk.home %}<a href="{{ talk.home }}" target="_blank" rel="noopener">{{ talk.speaker }} {% icon "arrow-up-right" %}</a>{% else %}{{ talk.speaker }}{% endif %}{% if talk.institution %} · {{ talk.institution }}{% endif %}</p>
{% endcall %}
<article class="container talk-detail section-space">
  <div class="detail-grid">
    <aside class="event-facts"><div><p class="eyebrow">When</p><p>{{ talk.date.full }}</p><strong>{{ talk.date.time }}</strong></div><div><p class="eyebrow">Where</p><p>Online</p></div>{% if not talk.archived and not talk.cancelled %}<a href="/about/#join" class="text-link">Attend this talk {% icon "arrow-up-right" %}</a>{% if talk.calendar %}<a class="text-link calendar-link" href="{{ talk.calendar }}" download>{% icon "calendar-plus" %} Add to calendar</a>{% endif %}{% endif %}{% if talk.cancelled %}<p class="cancelled">This talk was cancelled.</p>{% endif %}</aside>
    <div class="prose talk-copy">{{ talk.body | safe }}</div>
  </div>
</article>
