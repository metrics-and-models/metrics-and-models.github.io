{#- A seminar card with a coloured side edge. Expects `event`. -#}
{% if event.isBreak %}
<aside class="talk-card break-card" aria-label="No seminar on {{ event.date.day }} {{ event.date.month }} {{ event.date.year }}">
  <time class="card-date" datetime="{{ event.date.iso }}">{{ event.date.day }} {{ event.date.month }} {{ event.date.year }} · No seminar</time>
  <h3>{{ event.title }}</h3>
  <p class="card-text">{{ event.message }}</p>
</aside>
{% else %}
<a class="talk-card accent-{{ loop.index0 % 4 }}{% if event.url == seminars.next.url %} is-next{% endif %}" href="{{ event.url }}">
  <span class="card-date">{{ event.date.day or "TBC" }} {{ event.date.month }} · {{ event.date.time or "Time TBC" }}{% if event.url == seminars.next.url %}<span class="next-marker">Next talk</span>{% endif %}</span>
  <h3>{{ event.title | displayTitle }}</h3>
  <p class="card-text">{{ event.speaker | replace("CANCELLED ", "") }}{% if event.institution %} · {{ event.institution }}{% endif %}</p>
  <span class="card-more">Talk details {% icon "arrow-right" %}</span>
</a>
{% endif %}
