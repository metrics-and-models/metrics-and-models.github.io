<figure class="science-decoration" data-animation-group data-animation-name="{{ plot }} animation">
  <canvas data-plot="{{ plot }}" width="124" height="72" role="img" aria-label="{{ plotLabel }}"></canvas>
  <button class="motion-toggle icon-button" aria-label="Pause {{ plot }} animation" title="Pause {{ plot }} animation"><span data-pause>{% icon "pause" %}</span><span data-play hidden>{% icon "play" %}</span></button>
</figure>
