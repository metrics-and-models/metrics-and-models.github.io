<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#fcfcfa">
  <meta name="description" content="{{ description or site.description }}">
  <meta name="robots" content="noindex, nofollow">
  <title>{% if talk %}{{ talk.speaker }}{% elif title %}{{ title }}{% else %}Health & social data science{% endif %} | Metrics and Models</title>
  <meta property="og:title" content="{{ title or site.name }}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:type" content="website">
  <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
  <link rel="preload" href="/assets/fonts/instrument-sans.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/site.css">
  <noscript><style>.motion-toggle,.archive-tools{display:none}@media(max-width:420px){.header-inner{height:auto;padding-block:16px}.menu-toggle{display:none}#main-nav{display:flex;position:static;flex-wrap:wrap;padding:12px 0 0;width:100%;border:0}}</style></noscript>
  <script src="/assets/site.js" defer></script>
  {% if home %}<script src="/assets/field.js" defer></script>{% endif %}
</head>
<body>
  <a href="#main" class="skip-link">Skip to content</a>
  <header class="site-header">
    <div class="container header-inner">
      <a class="wordmark" href="/" aria-label="Metrics and Models home">Metrics and Models</a>
      <button class="menu-toggle icon-button" aria-label="Open navigation" aria-expanded="false" aria-controls="main-nav">{% icon "menu" %}</button>
      <nav id="main-nav" aria-label="Main navigation">
        <a href="/" {% if section == "seminars" %}aria-current="page"{% endif %}>Seminars</a>
        <a href="/people/" {% if section == "people" %}aria-current="page"{% endif %}>People</a>
        <a href="/about/" {% if section == "about" %}aria-current="page"{% endif %}>About</a>
      </nav>
    </div>
  </header>
  <main id="main">{{ content | safe }}</main>
  <footer class="site-footer">
    <div class="container footer-bottom"><span>Metrics and Models / University of Oxford</span><div class="footer-links"><a href="/details/internal_lab_sessions.html">Internal sessions</a><a href="mailto:{{ site.email }}">Contact</a><a href="https://github.com/metrics-and-models/metrics-and-models.github.io/tree/dev">Source</a></div></div>
  </footer>
</body>
</html>
