---
layout: base.njk
title: People
section: people
animated: true
permalink: /people/index.html
---
<div class="container section-space">
  <header class="page-heading">
    <div class="heading-line"><h1>People</h1>{% set plot = "network" %}{% set plotLabel = "Illustrative animated network connections" %}{% include "science-decoration.njk" %}</div>
    <p>Lab members, working across health and social data science.</p>
  </header>
  <div class="people-grid">
  {% for person in people %}
    <article class="person">
      <div>
        <h2>{{ person.name }}</h2>
        <p class="person-role">{{ person.role }}</p>
        {% if person.interests | length %}<p class="person-interests">{{ person.interests | join("; ") }}.</p>{% endif %}
        {% if person.bio %}<p class="person-bio">{{ person.bio }}</p>{% endif %}
        {% if person.url or person.links | length %}
        <div class="person-links">
          {% if person.url %}<a class="person-homepage" href="{{ person.url }}" target="_blank" rel="noopener" aria-label="{{ person.name }}: {{ person.urlLabel or 'Website' }}">{{ person.urlLabel or "Website" }} {% icon "arrow-up-right" %}</a>{% endif %}
          {% for link in person.links %}<a href="{{ link.url }}" target="_blank" rel="noopener" aria-label="{{ person.name }}: {{ link.label }}">{{ link.label }} {% icon "arrow-up-right" %}</a>{% endfor %}
        </div>
        {% endif %}
      </div>
      {% if person.photo %}<img class="person-photo" src="{{ person.photo }}" alt="{{ person.name }}" width="88" height="104" loading="lazy">{% endif %}
    </article>
  {% endfor %}
  </div>
  <p class="people-note">Interested in joining the lab? <a href="mailto:{{ site.email }}">Get in touch</a>. Our <a href="/#upcoming">seminar series</a> is open to everyone.</p>
</div>
