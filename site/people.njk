---
layout: base.njk
title: People
section: people
permalink: /people/index.html
---
<div class="container section-space">
  <header class="page-heading"><h1>People</h1><p>The people who organise Metrics and Models.</p></header>
  <div class="people-grid">
  {% for person in people %}
    <article class="person">
      {% if person.photo %}<img class="person-photo" src="{{ person.photo }}" alt="{{ person.name }}" width="88" height="88" loading="lazy">{% endif %}
      <div><h2><a href="{{ person.url }}" target="_blank" rel="noopener">{{ person.name }} {% icon "arrow-up-right" %}</a></h2>{% if person.role and person.role != "Organising team" %}<p>{{ person.role }}</p>{% endif %}{% if person.affiliation %}<p>{{ person.affiliation }}</p>{% endif %}{% if person.bio %}<p class="person-bio">{{ person.bio }}</p>{% endif %}</div>
    </article>
  {% endfor %}
  </div>
  <p class="people-note">You do not need to be based at Oxford to attend the seminars. <a href="/about/#join">Joining information</a>.</p>
</div>
