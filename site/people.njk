---
layout: base.njk
title: People
section: people
animated: true
permalink: /people/index.html
---
{% from "hero.njk" import hero with context %}
{% call hero("page") %}
  <p class="eyebrow-code">// the lab</p>
  <h1>People</h1>
{% endcall %}
<div class="container section-space people-page">
  <div class="people-grid">
  {% for person in people %}
    <article class="person">
      <div>
        <h2>{{ person.name }}</h2>
        {% if person.interests | length %}<p class="person-interests">{{ person.interests | join("; ") }}.</p>{% endif %}
        {% if person.bio %}<p class="person-bio">{{ person.bio }}</p>{% endif %}
        {% if person.url or person.links | length %}
        <div class="person-links">
          {% if person.url %}<a class="person-homepage" href="{{ person.url }}" target="_blank" rel="noopener" aria-label="{{ person.name }}: {{ person.urlLabel or 'Website' }}">{{ person.urlLabel or "Website" }} {% icon "arrow-up-right" %}</a>{% endif %}
          {% for link in person.links %}<a href="{{ link.url }}" target="_blank" rel="noopener" aria-label="{{ person.name }}: {{ link.label }}">{{ link.label }} {% icon "arrow-up-right" %}</a>{% endfor %}
        </div>
        {% endif %}
      </div>
      {% if person.photo %}<span class="person-photo-frame"{% if person.photoCrop %} data-crop="{{ person.photoCrop }}"{% endif %}><img class="person-photo" src="{{ person.photo }}" alt="{{ person.name }}" width="76" height="90" loading="lazy"></span>{% endif %}
    </article>
  {% endfor %}
  </div>
  <p class="people-note">Interested in joining the lab? <a href="mailto:{{ site.email }}">Get in touch</a>. Our <a href="/seminars/">seminar series</a> is open to everyone.</p>
</div>
